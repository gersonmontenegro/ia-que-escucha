# Copia este archivo a .env y ajusta lo que necesites:  cp .env.example .env
# Por defecto TODO corre en local: Ollama nativo en el Mac + Qdrant y la app en Docker.

# ---------------------------------------------------------------- Transcripción
# faster-whisper (CPU, dentro de Docker) | mlx (nativo en el Mac) | openai (API)
TRANSCRIBER=faster-whisper
WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=es

# ---------------------------------------------------------------- Chunking
CHUNK_MAX_CHARS=700
CHUNK_OVERLAP_SEGMENTS=1

# ---------------------------------------------------------------- Embeddings
# Ollama visto desde Docker. Si corres la app nativa, usa http://localhost:11434/v1
EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=ollama
EMBED_MODEL=bge-m3

# ---------------------------------------------------------------- Base vectorial
# qdrant | numpy
VECTOR_STORE=qdrant
# Desde Docker, docker-compose la reemplaza por http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
TOP_K=4
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Reintentos de búsqueda tras la consulta inicial (3 = hasta 4 búsquedas)
MAX_QUERY_RETRIES=2

# ---------------------------------------------------------------- LLM
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
# Confirma el nombre exacto con: ollama list
LLM_MODEL=qwen3.8:27b
LLM_TEMPERATURE=0.2
# Parámetros extra para el proveedor, en JSON. Ollama acepta reasoning_effort=none.
LLM_EXTRA_BODY={"reasoning_effort":"none"}

# ==============================================================================
# PRESETS EN LA NUBE (descomenta y reemplaza lo de arriba)
# ==============================================================================
# --- LLM en OpenRouter (el mismo Qwen, pero en la nube) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=qwen/qwen3.8-27b
#
# --- LLM en OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=<el modelo de tu cuenta>
#
# --- Embeddings en OpenAI (¡hay que reindexar al cambiar de modelo!) ---
# EMBED_BASE_URL=https://api.openai.com/v1
# EMBED_API_KEY=sk-...
# EMBED_MODEL=text-embedding-3-small
#
# --- Transcripción en Groq ---
# TRANSCRIBER=openai
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_API_KEY=gsk_...
# WHISPER_MODEL=whisper-large-v3-turbo
#
# --- Qdrant Cloud ---
# QDRANT_URL=https://xxxx.cloud.qdrant.io
# QDRANT_API_KEY=...
